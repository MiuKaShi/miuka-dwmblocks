#!/bin/bash

IMLIST_FILE="/tmp/fcitx5-imlist"

case $BLOCK_BUTTON in
    1) fcitx5-switch ;;
    2) fcitx5-config-qt ;;
    3) notify-send "🌐 Language module" "\- Click to toggle
🦅: English
🐼: Chinese
🍊: Japanese
" ;;
    6) "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# 获取当前输入法名称
name=$(fcitx5-remote -n)

# 根据输入法名称匹配图标
case "$name" in
    "pinyin" | "rime" | "ㄓ")
        icon="🐼CN"
        ;;
    "mozc" | "あ")
        icon="🍊JP"
        ;;
    "" | "keyboard-us" | "en")
        icon="🦅EN"
        ;;
esac

printf '%s\n' "$icon"
