case $GPU_MODE in
    intel) MODE="💻GPU:Intel" ;;
    nvidia)
        POWER=$(nvidia-smi --query-gpu=power.draw --format=csv,noheader,nounits | paste -sd '/')
        MODE="🚀GPU:Nvidia(${POWER%.*}W)"
        ;;
    hybrid) MODE="✨GPU:Hybrid" ;;
esac

printf '%s\n' "$MODE"
