#!/bin/sh

case $BLOCK_BUTTON in
    1) sudo dmenugpu ;;
    3) notify-send "🔰 GPU module" "\- Click to toggle
🚀: Nvidia
💻: Intel
" ;;
    6) "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

